# Cloudflare Pages deployment (GitHub Actions repository secrets)
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here

# Optional public Supabase Storage base URL. Leave empty to serve bundled images.
# Keep the same category subdirectories and filenames as public/catalog/.
# Example: https://PROJECT.supabase.co/storage/v1/object/public/catalog
NEXT_PUBLIC_CATALOG_MEDIA_URL=

# Optional Supabase client configuration; the storefront needs neither to run.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
