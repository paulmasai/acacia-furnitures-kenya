# Cloudflare Pages deployment (GitHub Actions repository secrets)
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here

# Supabase project (public values — safe for browser / build-time bake-in)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_or_publishable_key

# Public Storage base for catalog images. Leave empty to serve /public/catalog locally.
# After uploading: https://YOUR_PROJECT.supabase.co/storage/v1/object/public/catalog
NEXT_PUBLIC_CATALOG_MEDIA_URL=

# Server-only: used by scripts/upload-catalog-to-supabase.mjs. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
