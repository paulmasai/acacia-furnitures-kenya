# ==============================================================================
# ACACIA FURNITURE KENYA — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env.local for local development.
# For Cloudflare Pages & GitHub Actions, configure these secrets in your dashboard.

# ------------------------------------------------------------------------------
# 1. CLOUDFLARE PAGES & WORKERS DEPLOYMENT
# ------------------------------------------------------------------------------
# Your Cloudflare API Token with "Cloudflare Pages: Edit" permissions
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here

# Found in your Cloudflare dashboard under Account ID (or dashboard URL)
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here

# Cloudflare Pages project name (matches wrangler.toml)
CLOUDFLARE_PROJECT_NAME=acacia-furniture-kenya

# ------------------------------------------------------------------------------
# 2. SUPABASE DATABASE & STORAGE ENGINE (Media & Products)
# ------------------------------------------------------------------------------
# Public Supabase URL for client-side queries and public bucket assets
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Public anonymous key for client requests (safe for browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Secret service role key for backend/admin operations (NEVER expose to browser)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ------------------------------------------------------------------------------
# 3. STOREFRONT & BUSINESS IDENTIFIERS
# ------------------------------------------------------------------------------
NEXT_PUBLIC_STORE_NAME="Acacia Furniture Kenya"
NEXT_PUBLIC_STORE_TAGLINE="Direct Manufacturer & Corporate Importer • Nairobi"
NEXT_PUBLIC_STORE_LOCATION="Industrial Area, Nairobi, Kenya"
NEXT_PUBLIC_WHATSAPP_NUMBER="+254703404563"
NEXT_PUBLIC_HOTLINE_PHONE="+254703404563"
NEXT_PUBLIC_SALES_EMAIL="sales@acaciafurniture.co.ke"
NEXT_PUBLIC_CURRENCY="KSh"

# ------------------------------------------------------------------------------
# 4. M-PESA & LOCAL PAYMENT INTEGRATION
# ------------------------------------------------------------------------------
NEXT_PUBLIC_MPESA_TILL_NUMBER="892410"
NEXT_PUBLIC_MPESA_PAYBILL_NUMBER="400200"

# Optional: Safaricom Daraja API Keys for direct STK Push checkout
MPESA_CONSUMER_KEY=your_mpesa_consumer_key_here
MPESA_CONSUMER_SECRET=your_mpesa_consumer_secret_here
MPESA_PASSKEY=your_mpesa_passkey_here
MPESA_SHORTCODE=your_mpesa_shortcode_here

# ------------------------------------------------------------------------------
# 5. MEDIA ENGINE & HIGGSFIELD VIDEO LOOPS
# ------------------------------------------------------------------------------
# Public CDN URL for ambient video loop (e.g., Supabase bucket or Higgsfield MP4)
NEXT_PUBLIC_HERO_VIDEO_URL=""
